# ASCEND Environment Variables

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Email (SMTP) Configuration
# Supports Gmail, SendGrid, Mailgun, or any SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="ASCEND <your_email@gmail.com>"

# Admin email for receiving alerts
ADMIN_EMAIL=admin@ascend.com

# Admin panel password (used to sign in at /admin)
# REQUIRED in production: if it is missing the admin panel FAILS CLOSED —
# every login is rejected and /admin stays locked until the variable is set.
# The login screen at /admin/login explains how to unlock it:
#   Vercel → Project → Settings → Environment Variables → ADMIN_PASSWORD
#   → Redeploy (Deployments → ⋯ → Redeploy)
# Local development only: with no value set, the built-in default
# `ascend2024` is accepted so `npm run dev` works out of the box.
ADMIN_PASSWORD=change-me-to-a-strong-password
